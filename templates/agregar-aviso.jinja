{% extends "base.jinja" %}
{% block css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/agregar-aviso.css') }}">
{% endblock css %}
{% block title %}
Agregar aviso
{% endblock title %}
{% block content %}
<div id="caja-form">
    {% if error_title %}
    <h3 id="msg-title">{{error_title}}</h3>
    <p id="msg">{{error_msg}}</p>
    <ul id="val-list">
        {% for err_detail in error_list %}
        <li>{{err_detail}}</li>
        {% endfor %}
    </ul>
    {% elif correct_msg %}
    <h3 id="msg">{{correct_msg}}</h3>
    <button onclick="window.location='/aviso'">Volver</button>
    {% else %}
    <div id="error-msg" hidden>
        <h3 id="msg-title"></h3>
        <p id="msg"></p>
        <ul id="val-list"></ul>
    </div>
    <form name="myForm" method="post" enctype="multipart/form-data" action="{{url_for('aviso')}}">
        <h3>Información de ubicación</h3>
        <div class="form-field">
            <label for="select-region">Región</label>
            <select name="select-region" id="select-region">
                <option value="">Selecciona una Región</option>
            </select>
        </div>
        <div class="form-field">
            <label for="select-comuna">Comuna</label>
            <select name="select-comuna" id="select-comuna">
                <option value="">Selecciona una comuna</option>
            </select>
        </div>
        <div class="form-field">
            <label for="sector">Sector</label>
            <input type="text" maxlength="100" id="sector" name="sector" placeholder="Introduce el sector (opcional)">
        </div>
        <hr>
        <h3>Información de contacto</h3>
        <div class="form-field">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" required minlength="3" maxlength="200" placeholder="Introduce tu nombre">
        </div>

        <div class="form-field">
            <label for="email">Email</label>
            <input type="text" id="email" name="email" required maxlength="100" placeholder="Introduce tu email">
        </div>
        <div class="form-field">
            <label for="tel">Número de teléfono</label>
            <input type="tel" name="tel" id="tel" name="telefono" placeholder="Introduce tu número de teléfono (opcional)">
        </div>
        <fieldset>
            <legend>Contactar por</legend>
            <div class="checkbox-field" id="opt-1">
                <label for="contact-opt-1">Whatsapp</label>
                <input type="checkbox" name="whatsapp" id="contact-opt-1" class="chkbx">
                <input type="text" style="display: none;" id="whatsapp-input-text" minlength="4" maxlength="50">
            </div>
            <div class="checkbox-field" id="opt-2">
                <label for="contact-opt-2">TikTok</label>
                <input type="checkbox" name="tiktok" id="contact-opt-2" class="chkbx">
            </div>
            <div class="checkbox-field" id="opt-3">
                <label for="contact-opt-3">Telegram</label>
                <input type="checkbox" name="telegram" id="contact-opt-3" class="chkbx">
            </div>
            <div class="checkbox-field" id="opt-4">
                <label for="contact-opt-4">X</label>
                <input type="checkbox" name="x" id="contact-opt-4" class="chkbx">
            </div>
            <div class="checkbox-field" id="opt-5">
                <label for="contact-opt-5">Instagram</label>
                <input type="checkbox" name="instagram" id="contact-opt-5" class="chkbx">
            </div>
            <div class="checkbox-field" id="opt-6">
                <label for="contact-opt-6">Otra</label>
                <input type="checkbox" name="otra" id="contact-opt-6" class="chkbx">
            </div>
        </fieldset>
        <hr>
        <h3>Información de mascota</h3>
        <fieldset>
            <legend>Selecciona un tipo de mascota</legend>
            <label for="perro">Perro</label>
            <input type="radio" name="tipo" value="perro" id="perro" required>
            <label for="gato">Gato</label>
            <input type="radio" name="tipo" value="gato" id="gato">
        </fieldset>
        <div class="form-field">
            <label for="cantidad">Cantidad</label>
            <input type="number" name="cantidad" id="cantidad" required>
        </div>
        <div class="form-field">
            <label for="edad">Edad</label>
            <input type="number" name="edad" id="edad" required>
        </div>
        <fieldset>
            <legend>Unidad de medida de edad</legend>
            <label for="meses">Meses</label>
            <input type="radio" name="medida" value="meses" id="meses" required>
            <label for="años">Años</label>
            <input type="radio" name="medida" value="años" id="años">
        </fieldset>
        <div class="form-field">
            <label for="fecha">Fecha entrega</label>
            <input type="datetime-local" name="fecha" id="fecha" required>
        </div>
        <div class="form-field">
            <label for="desc">Descripción</label>
            <textarea id="desc" name="desc" rows="10" cols="50" placeholder="Descripción (opcional)"></textarea>
        </div>
        <div class="form-field" id="foto-field">
            <div id="foto-box">
                <label for="foto">Foto</label>
                <input type="file" name="foto" id="foto" class="fotos" required accept="image/*">
            </div>
            <button type="button" id="add-photo">Agregar otra foto</button>
        </div>
        <button id="submit-btn" type="button">Agregar este aviso de adopción</button>
    </form>
    {% endif %}
</div>
{% endblock content %}
{% block javascript %}
<script src="{{ url_for('static', filename='js/inicializarForm.js') }}" type="module"></script>
<script src="{{ url_for('static', filename='js/validaciones.js') }}" type="module"></script>
{% endblock javascript %}